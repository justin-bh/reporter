// reporter data model — the source of truth for the whole system.
// Change shape here, then `prisma migrate dev --name <change>`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EngagementStatus {
  active
  complete
  archived
}

enum EngagementRole {
  admin
  write
  read
}

enum AuthScheme {
  local
  oidc
  recovery
}

enum SavedQueryType {
  evidence
  findings
}

/** Qualitative finding severity, matching the CVSS v3.1 severity rating scale. */
enum Severity {
  none
  low
  medium
  high
  critical
}

/** Estimated effort to remediate a finding. */
enum FixEffort {
  none
  low
  medium
  high
}

/** Whether a finding records a weakness (default) or a security strength. */
enum FindingKind {
  weakness
  strength
}

model User {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  admin     Boolean   @default(false)
  disabled  Boolean   @default(false)
  headless  Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  identities   AuthIdentity[]
  webauthn     WebauthnCredential[]
  recovery     RecoveryCode[]
  apiKeys      ApiKey[]
  sessions     Session[]
  roles        UserEngagementRole[]
  prefs        UserEngagementPref[]
  evidencePrefs UserEvidencePref[]
  evidence     Evidence[]

  @@map("users")
}

model AuthIdentity {
  id                Int        @id @default(autoincrement())
  userId            Int        @map("user_id")
  scheme            AuthScheme
  identifier        String
  passwordHash      String?    @map("password_hash")
  mustResetPassword Boolean    @default(false) @map("must_reset_password")
  totpSecret        String?    @map("totp_secret")
  lastLogin         DateTime?  @map("last_login")
  createdAt         DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheme, identifier])
  @@index([userId])
  @@map("auth_identities")
}

model WebauthnCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  credentialId Bytes    @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  signCount    Int      @default(0) @map("sign_count")
  transports   String?
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

model ApiKey {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  accessKey String    @unique @map("access_key")
  secretKey Bytes     @map("secret_key")
  lastAuth  DateTime? @map("last_auth")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Session {
  id        String   @id // sha256 hex of the cookie token
  userId    Int      @map("user_id")
  data      Json?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Engagement {
  id        Int             @id @default(autoincrement())
  slug      String          @unique
  name      String
  status    EngagementStatus @default(active)
  // Lifecycle dates. `startedAt` defaults to creation time but is editable.
  // `projectedEndAt` is an operator-entered target. `actualEndAt` is stamped when
  // the engagement leaves `active` (into complete/archived) and cleared on return.
  startedAt      DateTime  @default(now()) @map("started_at")
  projectedEndAt DateTime? @map("projected_end_at")
  actualEndAt    DateTime? @map("actual_end_at")
  // Optional report metadata. Surfaced on the exported findings-report PDF (cover,
  // engagement-details page, executive summary, methodology). All null-until-set.
  clientName       String? @map("client_name")
  assessmentType   String? @map("assessment_type")
  location         String?
  scope            String?
  executiveSummary String? @map("executive_summary")
  methodology      String?
  // Per-engagement report watermark, drawn on every page of the exported PDF
  // except the title page. `watermarkText` null → "CONFIDENTIAL"; `watermarkColor`
  // null → a neutral gray. Opacity is one of light|medium|strong; layer is
  // behind|front (under vs. above the page content).
  watermarkEnabled Boolean @default(true) @map("watermark_enabled")
  watermarkText    String? @map("watermark_text")
  watermarkColor   String? @map("watermark_color")
  watermarkOpacity String  @default("medium") @map("watermark_opacity")
  watermarkLayer   String  @default("behind") @map("watermark_layer")
  // Structured report content, all editable in Engagement Settings and rendered
  // into the exported PDF. The list-shaped fields are JSON (jsonb) arrays whose
  // item shapes are validated by zod in @reporter/shared and default to `[]`.
  // `threatModelNarrative` is prose, like `executiveSummary`.
  scopeTargets             Json    @default("[]") @map("scope_targets")
  scopeExclusions          Json    @default("[]") @map("scope_exclusions")
  strategicRecommendations Json    @default("[]") @map("strategic_recommendations")
  threatModelNarrative     String? @map("threat_model_narrative")
  threatModelDiagrams      Json    @default("[]") @map("threat_model_diagrams")
  executionNarrative       Json    @default("[]") @map("execution_narrative")
  providerContacts         Json    @default("[]") @map("provider_contacts")
  clientContacts           Json    @default("[]") @map("client_contacts")
  softwareTested           Json    @default("[]") @map("software_tested")
  thirdPartySoftware       Json    @default("[]") @map("third_party_software")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  roles       UserEngagementRole[]
  prefs       UserEngagementPref[]
  evidence    Evidence[]
  findings    Finding[]
  tags        Tag[]
  savedQueries SavedQuery[]

  @@map("engagements")
}

model UserEngagementRole {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  engagementId Int           @map("engagement_id")
  role        EngagementRole

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([userId, engagementId])
  @@index([engagementId])
  @@map("user_engagement_roles")
}

model UserEngagementPref {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  engagementId Int     @map("engagement_id")
  isFavorite  Boolean @default(false) @map("is_favorite")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([userId, engagementId])
  @@map("user_engagement_prefs")
}

model UserEvidencePref {
  id         Int     @id @default(autoincrement())
  userId     Int     @map("user_id")
  evidenceId Int     @map("evidence_id")
  isFavorite Boolean @default(false) @map("is_favorite")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([userId, evidenceId])
  @@map("user_evidence_prefs")
}

model Tag {
  id          Int    @id @default(autoincrement())
  engagementId Int    @map("engagement_id")
  name        String
  colorName   String @map("color_name")

  engagement Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  evidence  EvidenceTag[]

  @@unique([engagementId, name])
  @@index([engagementId])
  @@map("tags")
}

model DefaultTag {
  id        Int    @id @default(autoincrement())
  name      String @unique
  colorName String @map("color_name")

  @@map("default_tags")
}

/**
 * Site-wide branding for generated report PDFs. A single row (id = 1); the
 * service layer upserts/reads that one row. `logoDataUri` holds an inline
 * data: URI (small PNG/SVG) so the logo embeds directly in the PDF with no
 * blob-store round-trip. Defaults ship the Block Harbor house style.
 */
model ReportSettings {
  id               Int      @id @default(1)
  organizationName String   @default("Block Harbor") @map("organization_name")
  accentColor      String   @default("#e82434") @map("accent_color")
  logoDataUri      String?  @map("logo_data_uri")
  footerNote       String?  @map("footer_note")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("report_settings")
}

model Evidence {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  engagementId    Int      @map("engagement_id")
  operatorId     Int      @map("operator_id")
  description    String   @default("")
  contentType    String   @map("content_type")
  contentSubtype String?  @map("content_subtype")
  // Original uploaded filename, when known. Used to name files in the report's
  // supporting-files ZIP bundle and the "Files Attached" table; synthesized from
  // the description + content type when absent (older evidence).
  originalFilename String? @map("original_filename")
  fullBlobKey    String?  @map("full_blob_key")
  thumbBlobKey   String?  @map("thumb_blob_key")
  // SHA-256 (hex) and byte size of the stored blob, computed once at upload. Lets
  // the report's supporting-files table list hashes/sizes without re-reading every
  // blob on each export. Null for evidence created before this existed (the report
  // then falls back to hashing the blob on demand).
  sha256         String?  @map("sha256")
  sizeBytes      Int?     @map("size_bytes")
  // When set, this evidence is a comment (linked evidence) on another piece of
  // evidence. Enforced one level deep in the service layer. SetNull so deleting
  // a parent orphans its comments into top-level evidence rather than erroring;
  // the web delete handler offers an explicit cascade instead.
  parentEvidenceId Int?   @map("parent_evidence_id")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  engagement Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  operator  User               @relation(fields: [operatorId], references: [id])
  parent    Evidence?          @relation("EvidenceComments", fields: [parentEvidenceId], references: [id], onDelete: SetNull)
  comments  Evidence[]         @relation("EvidenceComments")
  tags      EvidenceTag[]
  findings  EvidenceFinding[]
  metadata  EvidenceMetadata[]
  userPrefs UserEvidencePref[]

  @@index([engagementId, occurredAt])
  @@index([parentEvidenceId])
  @@map("evidence")
}

model EvidenceMetadata {
  id         Int    @id @default(autoincrement())
  evidenceId Int    @map("evidence_id")
  source     String
  body       String @default("")
  status     String @default("complete")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, source])
  @@map("evidence_metadata")
}

model FindingCategory {
  id        Int       @id @default(autoincrement())
  category  String    @unique
  deletedAt DateTime? @map("deleted_at")

  findings Finding[]

  @@map("finding_categories")
}

model Finding {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  engagementId  Int       @map("engagement_id")
  categoryId    Int?      @map("category_id")
  title         String
  description   String    @default("")
  /** Whether this finding is a weakness (default) or a security strength. */
  kind          FindingKind @default(weakness)
  /** System/component the finding applies to (e.g. a subsystem or host). */
  affectedTarget String   @default("") @map("affected_target")
  /** Business/technical impact if exploited — distinct from the description. */
  impact        String    @default("")
  /** Estimated remediation effort (weaknesses only). */
  fixEffort     FixEffort @default(none) @map("fix_effort")
  /** Recommended remediation / fix guidance, shown per-finding in the report. */
  remediation   String    @default("")
  /** Mapped ISO/SAE 21434 work-product/clause reference IDs (catalog in @reporter/shared). */
  iso21434Refs  Json      @default("[]") @map("iso21434_refs")
  /** Mapped UN R155 requirement reference IDs (catalog in @reporter/shared). */
  unr155Refs    Json      @default("[]") @map("unr155_refs")
  severity      Severity?
  cvssVector    String?   @map("cvss_vector")
  cvssScore     Float?    @map("cvss_score")
  position      Int       @default(0)
  readyToReport Boolean   @default(false) @map("ready_to_report")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  engagement Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  category  FindingCategory?  @relation(fields: [categoryId], references: [id])
  evidence  EvidenceFinding[]

  @@index([engagementId, position])
  @@map("findings")
}

model EvidenceTag {
  evidenceId Int @map("evidence_id")
  tagId      Int @map("tag_id")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([evidenceId, tagId])
  @@index([tagId])
  @@map("evidence_tags")
}

model EvidenceFinding {
  evidenceId Int     @map("evidence_id")
  findingId  Int     @map("finding_id")
  position   Int     @default(0)
  caption    String  @default("")
  inPath     Boolean @default(false) @map("in_path")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@id([evidenceId, findingId])
  @@index([findingId])
  @@map("evidence_findings")
}

model SavedQuery {
  id          Int            @id @default(autoincrement())
  engagementId Int            @map("engagement_id")
  name        String
  query       String
  type        SavedQueryType

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, name, type])
  @@map("saved_queries")
}
