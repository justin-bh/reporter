# ---------------------------------------------------------------------------
# reporter server configuration. Copy to `.env` and edit the marked values.
# (Expanded and finalized in Phase 5; safe defaults shown for local/LAN use.)
# ---------------------------------------------------------------------------

# --- Required: change these ---
# Secret used to sign session cookies. Generate: `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Password for the bundled PostgreSQL container.
DB_PASSWORD=change-me

# First-admin bootstrap (used only when the users table is empty).
# Leave blank to instead create the first admin via the web /setup screen.
ADMIN_EMAIL=admin@reporter.local
ADMIN_PASSWORD=change-me-too

# --- Access ---
# Host port the app is reached on. 80 = no port in the URL (http://<server-ip>).
# Change it (e.g. 8080) only if port 80 is already in use on the server.
HTTP_PORT=80
# Public URL browsers and clients use to reach the server. With HTTP_PORT=80,
# omit the port (e.g. http://reporter.lan or http://192.168.1.50).
APP_URL=http://localhost

# --- Database ---
# In Docker Compose this points at the `db` service; for local dev use localhost.
DATABASE_URL=postgres://reporter:change-me@db:5432/reporter

# --- Blob storage: local filesystem (default) or S3-compatible ---
BLOB_STORE=local
BLOB_DIR=/data/blobs
# When BLOB_STORE=s3:
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Limits ---
# Max evidence upload size in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600

# --- Optional auth integrations (leave blank to disable) ---
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# WebAuthn relying-party ID (usually the server hostname).
# WEBAUTHN_RP_ID=
